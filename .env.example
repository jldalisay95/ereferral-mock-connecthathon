# Optional endpoint overrides. The tracked defaults are in
# src/config/connectathon.config.ts. Do not put secrets in VITE_* variables;
# Vite exposes them to the browser.
#
# PHeRef FHIR server
VITE_PHEREF_BASE_URL=https://cdr.pheref.fhirlab.net/fhir
# PH Core FHIR server
VITE_PHCORE_BASE_URL=https://cdr.phcore.fhirlab.net/fhir
# Terminology server
VITE_TX_BASE_URL=https://tx.fhirlab.net/fhir

# Presets normally come from the npm scripts. Uncomment only for custom tooling.
# VITE_CONNECTATHON_PRESET=participant
